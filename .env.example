ORACLE_PASSWORD=ALTERAR
APP_USER_PASSWORD=ALTERAR
DB_USER=ticketops
DB_PASSWORD=ALTERAR
DB_DSN=db:1521/FREEPDB1

# As tres variaveis abaixo existem para a conexao com o Oracle Autonomous
# Database (OCI) e ficam VAZIAS no ambiente local — o container fala TCP simples.
# Em producao elas sao injetadas pelo Cloud Run: DB_WALLET_LOCATION como valor
# literal e DB_WALLET_PASSWORD a partir do Secret Manager (ver terraform/run.tf).
# DB_CONFIG_DIR so faz falta se o DB_DSN for um alias do tnsnames.ora; aqui ele e
# o descritor de conexao completo, entao continua vazio. Ver docs/adb/README.md.
# DB_CONFIG_DIR=
# DB_WALLET_LOCATION=
# DB_WALLET_PASSWORD=
